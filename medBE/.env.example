# ============================================
# medBE 환경 변수 템플릿
# 사용법: cp .env.example .env  후 값을 채우세요 (.env는 gitignore됨)
# ============================================

# --- Database (필수) ---
# JDBC URL. 로컬 예: jdbc:postgresql://localhost:5432/localMED_DB
# Supabase Direct 예: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT (필수) ---
JWT_SECRET=

# --- OpenAI GPT (필수) ---
OPENAI_API_KEY=
GPT_API_URL=
GPT_MODEL=

# --- Google Vision (선택) ---
GOOGLE_APPLICATION_CREDENTIALS=

# --- 식품의약품안전처 API (선택) ---
MFDS_API_URL=
MFDS_API_KEY=

# --- Email / Gmail SMTP (선택) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Python 분석 서비스 ---
PYTHON_API_URL=

# --- 콘텐츠 검증 ---
CONTENT_VALIDATION_ENABLED=

# --- 서버 (prod 프로필) ---
SERVER_PORT=
